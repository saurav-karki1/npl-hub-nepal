# Supabase Public Environment Variables (NPL Hub Nepal)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key

# Site & SEO Configuration
NEXT_PUBLIC_SITE_URL=https://nplhubnepal.vercel.app
NEXT_PUBLIC_GSC_VERIFICATION=your-google-search-console-verification-token
NEXT_PUBLIC_GA_ID=G-VBLLG090FH

# Contact Form Service (Formspree)
# 1. Sign up for free at https://formspree.io
# 2. Create a new form pointing to your verified destination email: nplhubnepal@gmail.com
# 3. Copy your Form ID (e.g., mlddegpw or f/mlddegpw) and set it below:
FORMSPREE_FORM_ID=your-formspree-form-id

# Optional: Alternatively specify a complete custom form delivery endpoint
# CONTACT_FORM_ENDPOINT=https://formspree.io/f/your-form-id
