# Supabase Public Environment Variables (NPL Hub Nepal)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key

# Site & SEO Configuration
NEXT_PUBLIC_SITE_URL=https://nplhubnepal.vercel.app
NEXT_PUBLIC_GSC_VERIFICATION=your-google-search-console-verification-token
NEXT_PUBLIC_GA_ID=G-VBLLG090FH

# Contact Form Service (Formspree)
# 1. Sign up for free at https://formspree.io
# 2. Create a new form pointing to your verified destination email: nplhubnepal@gmail.com
# 3. Copy your Form ID (e.g., mlddegpw or f/mlddegpw) and set it below:
FORMSPREE_FORM_ID=your-formspree-form-id

# Optional: Alternatively specify a complete custom form delivery endpoint
# CONTACT_FORM_ENDPOINT=https://formspree.io/f/your-form-id

# AI News Agent & Commentary (Server-Side Only)
# Primary Google Gemini API Key
GEMINI_API_KEY=your-primary-gemini-api-key

# Additional Gemini API Keys for automated rate-limit failover (Optional)
# If the primary key encounters 429 (Too Many Requests) or transient server errors,
# the agent automatically fails over to the next configured numbered key.
# GEMINI_API_KEY_2=your-secondary-gemini-api-key
# GEMINI_API_KEY_3=your-tertiary-gemini-api-key

# Secret token used by external cron schedulers (e.g. cron-job.org) via 'x-cron-secret' header
CRON_SECRET=your-random-32-char-cron-secret

# Supabase Service Role Key (server-side only, bypasses RLS for admin & agent operations)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Admin Authorization (Server-Side Only)
# Comma-separated list of verified admin email addresses allowed to manage the AI agent.
# Any authenticated user whose email is not in this list will be denied with 403 Forbidden.
# In production (Vercel), add your actual admin email address (e.g., nplhubnepal@gmail.com).
ADMIN_ALLOWED_EMAILS=your-admin-email@example.com
